#version 460
// Screen-space ambient occlusion at half resolution from the resolved scene
// depth (reverse-Z, 0 = sky). World-radius hemisphere sampling around the
// reconstructed normal, per-pixel rotated kernel, range check against
// depth discontinuities. Output 1 = unoccluded; the tonemap pass blurs it.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D aoImg;

layout(push_constant) uniform Push {
  mat4 viewProj;     // camera-relative
  mat4 invViewProj;
} pc;

const int kSamples = 14;
const float kRadius = 0.85;      // blocks
const float kFadeStart = 48.0;   // blocks from the camera
const float kFadeEnd = 80.0;

vec3 positionAt(vec2 uv, float depth) {
  vec4 p = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
  return p.xyz / p.w;
}

float ign(vec2 px) { return fract(52.9829189 * fract(dot(px, vec2(0.06711056, 0.00583715)))); }

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(aoImg);
  if (p.x >= size.x || p.y >= size.y) return;
  vec2 uv = (vec2(p) + 0.5) / vec2(size);
  float d = textureLod(depthTex, uv, 0.0).r;
  if (d <= 0.0) { imageStore(aoImg, p, vec4(1.0)); return; }

  vec3 P = positionAt(uv, d);
  float dist = length(P);
  if (dist > kFadeEnd) { imageStore(aoImg, p, vec4(1.0)); return; }

  // Normal from the flatter of the two neighbours on each axis (avoids
  // smearing across silhouettes).
  vec2 ts = 1.0 / vec2(textureSize(depthTex, 0));
  vec3 px = positionAt(uv + vec2(ts.x, 0), textureLod(depthTex, uv + vec2(ts.x, 0), 0.0).r);
  vec3 nx = positionAt(uv - vec2(ts.x, 0), textureLod(depthTex, uv - vec2(ts.x, 0), 0.0).r);
  vec3 py = positionAt(uv + vec2(0, ts.y), textureLod(depthTex, uv + vec2(0, ts.y), 0.0).r);
  vec3 ny = positionAt(uv - vec2(0, ts.y), textureLod(depthTex, uv - vec2(0, ts.y), 0.0).r);
  vec3 dx = abs(length(px) - dist) < abs(length(nx) - dist) ? px - P : P - nx;
  vec3 dy = abs(length(py) - dist) < abs(length(ny) - dist) ? py - P : P - ny;
  vec3 n = normalize(cross(dy, dx));
  if (dot(n, -P) < 0.0) n = -n;

  // Tangent frame rotated per pixel.
  float ang = ign(vec2(p)) * 6.2831853;
  vec3 up = abs(n.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
  vec3 t = normalize(cross(up, n));
  vec3 b = cross(n, t);
  float ca = cos(ang), sa = sin(ang);
  vec3 t2 = t * ca + b * sa, b2 = -t * sa + b * ca;

  float occ = 0.0;
  for (int i = 0; i < kSamples; ++i) {
    // Fibonacci hemisphere, samples denser near the centre.
    float fi = (float(i) + 0.5) / float(kSamples);
    float phi = float(i) * 2.3999632;
    float cosT = sqrt(1.0 - fi), sinT = sqrt(fi);
    vec3 h = vec3(cos(phi) * sinT, sin(phi) * sinT, cosT);
    float scale = mix(0.2, 1.0, fi * fi);
    vec3 s = P + (t2 * h.x + b2 * h.y + n * h.z) * (kRadius * scale) + n * 0.03;
    vec4 c = pc.viewProj * vec4(s, 1.0);
    if (c.w <= 0.0) continue;
    vec2 suv = c.xy / c.w * 0.5 + 0.5;
    if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0)))) continue;
    float sceneD = textureLod(depthTex, suv, 0.0).r;
    if (sceneD <= 0.0) continue;
    float sceneDist = length(positionAt(suv, sceneD));
    float sampleDist = length(s);
    float range = smoothstep(0.0, 1.0, kRadius / max(abs(dist - sceneDist), 1e-3));
    occ += (sceneDist < sampleDist - 0.02) ? range : 0.0;
  }
  float ao = 1.0 - occ / float(kSamples);
  ao = pow(clamp(ao, 0.0, 1.0), 1.7);
  ao = mix(ao, 1.0, smoothstep(kFadeStart, kFadeEnd, dist));
  imageStore(aoImg, p, vec4(ao));
}
